# GEMINI_MODEL=gemini-2.0-flash
# DAILY_COST_CAP_USD=1.00
# RECORDINGS_DIR=/path/to/web-viewer/public/recordings
# INPUT_PRICE_PER_1M=0.075
# OUTPUT_PRICE_PER_1M=0.30

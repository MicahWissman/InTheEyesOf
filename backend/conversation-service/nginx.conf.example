# Nginx snippet: proxy /api/* to the conversation service running on localhost:3001.
# Add this inside the server {} block of your existing site config.
#
# Example: /etc/nginx/sites-available/intheeyesof

server {
    listen 80;
    server_name your-pi-hostname.local;

    # Serve the React build
    root /home/eyesof/workspace/InTheEyesOf/web-viewer/dist;
    index index.html;

    # Proxy AI conversation API to Node service
    location /api/ {
        proxy_pass         http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
